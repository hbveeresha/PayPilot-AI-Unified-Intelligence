# Copy to .env to override local defaults.
APP_ENV=development
# DATABASE_URL=sqlite:///data/paypilot.db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=45
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SEED_DEMO_DATA=true
# Optional for off-host workspace administrator API access. Keep secret server-side.
# WORKSPACE_ADMIN_TOKEN=
APP_BASE_URL=http://127.0.0.1:8000

# Marketplace checkout pricing (USD). Taxes/shipping are calculated server-side.
MARKETPLACE_TAX_RATE=0.0825
MARKETPLACE_SHIPPING_FLAT=5.99
MARKETPLACE_FREE_SHIPPING_THRESHOLD=75.00
MARKETPLACE_ORDER_TTL_MINUTES=30
# Merchant images are normalized to WebP and stored privately outside the ZIP data bundle.
PRODUCT_UPLOAD_DIR=data/product_uploads
MARKETPLACE_MAX_IMAGE_BYTES=5242880

# Optional PayPal Developer Sandbox REST app credentials (server-side only).
# Create these in the PayPal Developer Dashboard. Never commit real secrets.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
